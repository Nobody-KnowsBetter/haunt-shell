# HauntShell Configuration
# Preferred open-weight model (gemma3, gemma2, llama3.2, deepseek-coder, mistral)
HAUNT_MODEL=gemma3

# Local Ollama daemon URL
HAUNT_OLLAMA_URL=http://localhost:11434

# Enforce 100% offline procedural lore without Ollama (true / false)
HAUNT_OFFLINE=false

# Visual atmosphere level (low / medium / high)
HAUNT_ATMOSPHERE=high

# Inference timeout in seconds
HAUNT_TIMEOUT=45.0
